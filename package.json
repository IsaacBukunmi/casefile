{
    "name": "casefile",
    "private": true,
    "packageManager": "pnpm@10.34.7",
    "engines": { "node": ">=22" },
    "scripts": {
        "dev": "pnpm --parallel --filter web --filter api dev",
        "build": "pnpm --filter web build",
        "typecheck": "pnpm --filter web typecheck",
        "lint": "pnpm -r lint",
        "test": "pnpm -r test",
        "format:check": "pnpm --filter web format:check",
        "format": "pnpm -r format"
    }
}