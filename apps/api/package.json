{
    "name": "api",
    "private": true,
    "scripts": {
      "dev": "uv run fastapi dev app/main.py --port 8000",
      "test": "uv run pytest",
      "lint": "uv run ruff check . && uv run ruff format --check .",
      "format": "uv run ruff format . && uv run ruff check --fix .",
      "db:migrate": "uv run alembic upgrade head",
      "db:revision": "uv run alembic revision --autogenerate -m",
      "db:seed": "uv run python -m app.seed",
      "export-openapi": "uv run python -m app.export_openapi ../../packages/api-types/openapi.json"
    }
  }