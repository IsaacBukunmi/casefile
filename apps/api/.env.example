DATABASE_URL=postgresql+psycopg://casefile:casefile@localhost:5432/casefile

# From the Clerk Dashboard > API keys. Put the PEM key on one line with \n between lines.
CLERK_ISSUER=https://your-app-00.clerk.accounts.dev
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# Optional: the Clerk organization IDs the seed's two sample firms should belong to.
SEED_HARLOW_ORG_ID=org_your_harlow_id
SEED_NORTHGATE_ORG_ID=org_your_northgate_id