  "components": {
    "schemas": {
      "ActivityEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "matter_id": {
            "type": "string",
            "title": "Matter Id"
          },
          "kind": {
            "$ref": "#/components/schemas/ActivityKind"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for system events, such as finished analysis."
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "matter_id",
          "kind",
          "actor",
          "description",
          "occurred_at"
        ],
        "title": "ActivityEvent"
      },
      "ActivityKind": {
        "type": "string",
        "enum": [
          "created",
          "edited",
          "uploaded",
          "analysis_ready",
          "accepted",
          "flagged",
          "asked"
        ],
        "title": "ActivityKind"
      },
      "Analysis": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AnalysisStatus"
          },
          "progress": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "risk_counts": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RiskCounts"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present only when status is 'ready'."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "progress",
          "risk_counts"
        ],
        "title": "Analysis"
      },
      "AnalysisStatus": {
        "type": "string",
        "enum": [
          "analysing",
          "ready",
          "failed"
        ],
        "title": "AnalysisStatus"
      },
      "ApiError": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reference": {
            "type": "string",
            "title": "Reference",
            "description": "Short code a user can quote to support, e.g. CF-4F1A-02."
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "reference",
          "details"
        ],
        "title": "ApiError"
      },
      "Clause": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "section_ref": {
            "type": "string",
            "title": "Section Ref"
          },
          "clause_type": {
            "type": "string",
            "title": "Clause Type"
          },
          "risk": {
            "type": "string",
            "title": "Risk"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "suggested_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Revision"
          },
          "review": {
            "$ref": "#/components/schemas/Review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "document_id",
          "section_ref",
          "clause_type",
          "risk",
          "explanation",
          "detail",
          "suggested_revision",
          "review"
        ],
        "title": "Clause"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "matter_id": {
            "type": "string",
            "title": "Matter Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "file_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "uploaded_by": {
            "$ref": "#/components/schemas/Person"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          },
          "analysis": {
            "$ref": "#/components/schemas/Analysis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "matter_id",
          "name",
          "file_type",
          "pages",
          "uploaded_by",
          "uploaded_at",
          "analysis"
        ],
        "title": "Document"
      },
      "DocumentDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "matter_id": {
            "type": "string",
            "title": "Matter Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "file_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "uploaded_by": {
            "$ref": "#/components/schemas/Person"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          },
          "analysis": {
            "$ref": "#/components/schemas/Analysis"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "parties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parties"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "matter_id",
          "name",
          "file_type",
          "pages",
          "uploaded_by",
          "uploaded_at",
          "analysis",
          "title",
          "parties",
          "sections"
        ],
        "title": "DocumentDetail"
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "pdf",
          "docx"
        ],
        "title": "DocumentType"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "validation_error",
          "internal_error"
        ],
        "title": "ErrorCode"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field",
            "description": "Where the problem is, e.g. 'query.status' or 'body.name'."
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "Matter": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "client": {
            "type": "string",
            "title": "Client"
          },
          "practice_area": {
            "$ref": "#/components/schemas/PracticeArea"
          },
          "status": {
            "$ref": "#/components/schemas/MatterStatus"
          },
          "owner": {
            "$ref": "#/components/schemas/Person"
          },
          "document_count": {
            "type": "integer",
            "title": "Document Count"
          },
          "last_activity_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Activity At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "client",
          "practice_area",
          "status",
          "owner",
          "document_count",
